# Ballpark environment variables — copy to .env.local and fill in your own values.
# Only NEXT_PUBLIC_* vars are exposed to the browser. NEVER prefix the Gemini key.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (AI Studio → Get API key) — SERVER ONLY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Daily per-user limits (server only)
DAILY_GENERATION_LIMIT=30
DAILY_EVALUATION_LIMIT=20

# Site URL — http://localhost:3000 locally, https://yourdomain.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000
