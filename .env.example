# Ballpark environment variables — copy to .env.local and fill in your own values.
# Only NEXT_PUBLIC_* vars are exposed to the browser. NEVER prefix the Gemini key.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (AI Studio → Get API key) — SERVER ONLY
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Daily per-user limits (server only)
DAILY_GENERATION_LIMIT=30
DAILY_EVALUATION_LIMIT=20

# Site URL — http://localhost:3000 locally, https://yourdomain.com in production
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Microsoft Clarity analytics (heatmaps + session recordings) — public project id
# from clarity.microsoft.com. Leave blank to disable Clarity (e.g. locally).
NEXT_PUBLIC_CLARITY_PROJECT_ID=

# Supabase service-role / secret key — SERVER ONLY (used by the Dodo webhook to
# update subscriptions; bypasses RLS). Project Settings → API Keys → secret key.
# NEVER expose this to the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Dodo Payments (Pro subscription) — all SERVER ONLY
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_ENVIRONMENT=test_mode
DODO_PRODUCT_ID=

# Pro daily limits
PRO_GENERATION_LIMIT=200
PRO_EVALUATION_LIMIT=150
